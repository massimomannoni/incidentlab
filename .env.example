# Copy to .env independently on Monitor and Target. Do not commit .env.
# Generate URL-safe random values; both hosts must use identical lab keys.
POSTGRES_PASSWORD=
LAB_INGEST_KEY=
LAB_CONTROL_KEY=
# Monitor and local worker only; at least 24 random characters. Never a Codex credential.
LAB_WORKER_KEY=

# Private IPv4 addresses returned by the AWS infrastructure stack.
TARGET_URL=http://TARGET_PRIVATE_IP:8080
MONITOR_URL=http://MONITOR_PRIVATE_IP:8010
# Bind private EC2 addresses, not public interfaces.
MONITOR_BIND_ADDRESS=MONITOR_PRIVATE_IP
TARGET_BIND_ADDRESS=TARGET_PRIVATE_IP

# Optional Codex worker runs on your Mac through an SSM tunnel to the monitor.
# Use MONITOR_URL=http://127.0.0.1:8010 for that worker, not the private EC2 HTTP URL.
# Codex account credentials stay on the Mac.

# Optional AWS Bedrock: run the approved IAM preparation first. No static AWS/API keys.
# EU cross-region processing must be approved; the endpoint remains Milan.
LAB_BEDROCK_ENABLED=false
LAB_BEDROCK_REGION=eu-south-1
LAB_BEDROCK_MONTHLY_CAP_USD=5
LAB_BEDROCK_DAILY_CAP_USD=0.50
